# .env.example — committed for reference (no values)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk — populated by `clerk env pull`
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Supabase
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
#
# Migrations only, never read at runtime: `supabase db push --db-url "$SUPABASE_DB_URL"`.
# Must be the Session pooler URI (postgres.<ref>@aws-#-<region>.pooler.supabase.com) --
# the direct-connection host db.<ref>.supabase.co has no IPv4 record and will not resolve.
# SUPABASE_DB_URL=

# Anthropic — report generation
# ANTHROPIC_API_KEY=

# Finnhub — US index and sector ETF quotes
# FINNHUB_API_KEY=

# Upstash QStash — schedules the post-close run and delivers it to the worker
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
