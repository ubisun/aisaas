# .env.example — committed for reference (no values)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk — populated by `clerk env pull`
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# Supabase
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
#
# Migrations only, never read at runtime: `supabase db push --db-url "$SUPABASE_DB_URL"`.
# Must be the Session pooler URI (postgres.<ref>@aws-#-<region>.pooler.supabase.com) --
# the direct-connection host db.<ref>.supabase.co has no IPv4 record and will not resolve.
# SUPABASE_DB_URL=

# Anthropic — report generation
# ANTHROPIC_API_KEY=

# Finnhub — US index and sector ETF quotes
# FINNHUB_API_KEY=

# Korea Investment Open API — the trading team's paper account.
# Paper credentials only: `lib/teams/trading/kis.ts` refuses to run when
# TRADING_CONFIG.environment is "real", and the live keys are deliberately
# absent from every deployment. Unset means the trading team cannot trade.
# KIS_PAPER_APP_KEY=
# KIS_PAPER_APP_SECRET=
# KIS_PAPER_ACCOUNT_NO=
#
# Account product code, the two digits after the dash in the account number.
# Optional — defaults to 01, which is right for a cash stock account.
# KIS_ACCOUNT_PRODUCT=

# Telegram — pipeline notifications. Both unset disables notifying entirely.
# TELEGRAM_CHAT_ID doubles as the allowlist for inbound commands.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
#
# Passed to setWebhook and echoed back by Telegram in the
# X-Telegram-Bot-Api-Secret-Token header. Inbound updates are rejected without it.
# TELEGRAM_WEBHOOK_SECRET=

# Upstash QStash — schedules the post-close run and delivers it to the worker
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
